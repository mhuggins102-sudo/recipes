{
  "name": "recipe-tabulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"wrangler pages dev --port 8788\" \"vite\"",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "html-to-image": "^1.11.13",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "concurrently": "^10.0.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
